{
  "name": "noxly-whitelist-helper",
  "version": "2.0.0",
  "description": "Discord bot that detects Minecraft \"not invited to play on this server\" screenshots via OCR and replies with the fix.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:image": "tsx scripts/check-image.ts",
    "prepare": "husky || true"
  },
  "keywords": [
    "discord",
    "discord.js",
    "minecraft",
    "whitelist",
    "ocr",
    "noxlydev"
  ],
  "author": "NoxlyDev",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pino": "^9.5.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": "prettier --write",
    "*.ts": "eslint --fix"
  }
}

# NoxlyDev Whitelist Helper — copy to .env and fill in

# ── Required ─────────────────────────────
# Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# ── Optional ─────────────────────────────
# Comma-separated channel IDs to watch (empty = all channels)
CHANNEL_IDS=

# Per-user cooldown in seconds
COOLDOWN_SECONDS=15

# trace | debug | info | warn | error  (replaces the old DEBUG=true)
LOG_LEVEL=info

# Image download safety limits
MAX_IMAGE_BYTES=8388608
FETCH_TIMEOUT_MS=10000

# OCR tuning (leave empty for automatic, based on CPU count)
OCR_CONCURRENCY=
OCR_RECIPE_TIMEOUT_MS=30000

